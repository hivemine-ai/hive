# ============================================================
# Hive v0.1 OSS — environment configuration (Docker / Compose)
# ============================================================
# Copy this file to `.env` and uncomment / change the values you need:
#
#     cp deployment/.env.example deployment/.env
#
# Defaults below match the values declared in the tech specs (Auth + Identity,
# Cell Store, Visibility Engine, Audit Log, Waggle + Presence, MCP Server).
# Lines that are commented out apply their tech-spec default; un-comment to
# override.
#
# Naming convention per [[Auth + Identity]] tech spec:
#     HIVE_<COMPONENT>_<NAME>   SCREAMING_SNAKE_CASE
#
# Two topologies are supported in v0.1 (per ADR-008):
#   - Topology 1 (default OSS): CLI + SQLite, no Docker. See packages/cli/README.md.
#   - Topology 2 (this file):   Docker Compose. SQLite-in-volume by default;
#                               Postgres opt-in via `--profile postgres`.
# ============================================================

# ─── Persistence (default: SQLite-in-container) ────────────────────────────
# Hive defaults to SQLite stored in the named volume `hive-db` mounted at
# /var/lib/hive/db. Zero external infrastructure required. Change these two
# vars and use `--profile postgres` to switch to Postgres.
HIVE_DB_DIALECT=sqlite
HIVE_DB_URL=sqlite:/var/lib/hive/db/hive.sqlite
# Optional — disable WAL journal mode for SQLite (default: enabled, safer
# concurrent reads). Leave commented unless you have a specific reason.
# HIVE_DB_SQLITE_WAL=true

# ─── Persistence (opt-in: Postgres) ────────────────────────────────────────
# Only used when `--profile postgres` activates the bundled hive-postgres
# service. POSTGRES_PASSWORD is REQUIRED in that case — the postgres:16 image
# fails fast at startup with `Database is uninitialized and superuser password
# is not specified` if it is empty. With `--profile postgres` active, also
# set HIVE_DB_DIALECT=postgres + HIVE_DB_URL pointing at the bundled
# hive-postgres service (see below).
POSTGRES_USER=hive
# POSTGRES_PASSWORD=                            # REQUIRED only with --profile postgres
POSTGRES_DB=hive
# When using --profile postgres, set these to switch the server off SQLite:
# HIVE_DB_DIALECT=postgres
# HIVE_DB_URL=postgres://hive:${POSTGRES_PASSWORD}@hive-postgres:5432/hive
# Optional — connection pool size (default 10).
# HIVE_DB_POOL_SIZE=10

# ─── Host networking ───────────────────────────────────────────────────────
# ⚠️ HIVE_BIND_HOST=0.0.0.0 exposes plain HTTP (no TLS) on the host interface.
# Only change to 0.0.0.0 if (a) a TLS-terminating reverse proxy fronts the
# server (nginx / Caddy / Traefik / cloud LB), or (b) the network is internal
# and isolated. Default 127.0.0.1 is the secure-by-default posture.
HIVE_BIND_HOST=127.0.0.1
HIVE_PUBLIC_PORT=8443

# ─── Auth + Identity (from [[Auth + Identity]]) ────────────────────────────
HIVE_AUTH_KEYS_DIR=/var/lib/hive/keys           # PEM directory (mounted via `hive-keys` volume)
HIVE_AUTH_CREDENTIAL_DEFAULT_TTL_DAYS=365
# HIVE_AUTH_CLOCK_TOLERANCE_SECONDS=5   # not read in v0.2.0
HIVE_AUTH_SNAPSHOT_MAX_BYTES=16384

# ─── Cell Store + Message Persistence (from [[Cell Store + Message Persistence]]) ─
# HIVE_CELL_MAX_BODY_BYTES=65536   # not read in v0.2.0
# HIVE_CELL_MAX_ACTION_BYTES=16384   # not read in v0.2.0
# Unread messages one sender may keep in one mailbox. Provisional. Lowering it never
# deletes anything: the pair stays blocked until the recipient marks messages read.
HIVE_CELL_MAX_UNREAD_PER_SENDER=500
# HIVE_CELL_IDEMPOTENCY_TTL_HOURS=24   # not read in v0.2.0
# HIVE_CELL_IDEMPOTENCY_KEY_MAX_LENGTH=256   # not read in v0.2.0
HIVE_CELL_EXPIRATION_INTERVAL_SECONDS=60
# HIVE_CELL_EXPIRATION_BATCH_SIZE=1000   # not read in v0.2.0
# HIVE_CELL_EXPIRATION_GRACE_DAYS=7   # not read in v0.2.0
HIVE_CELL_READ_MAX_PAGE_SIZE=100
# Hive-default retention applied at `hivectl init` (NULL = infinite):
# HIVE_CELL_DEFAULT_HIVE_UNREAD_RETENTION_MS=   # not read in v0.2.0
# HIVE_CELL_DEFAULT_HIVE_READ_RETENTION_MS=   # not read in v0.2.0

# ─── Visibility Engine + Audit Log (from [[Visibility Engine + Audit Log]]) ─
HIVE_VISIBILITY_AUDIT_CANSEE_DENIALS=false
# HIVE_AUDIT_RETENTION_DAYS=365                   # 0 disables purge  # not read in v0.2.0
# HIVE_AUDIT_PURGE_INTERVAL_HOURS=24   # not read in v0.2.0
# HIVE_AUDIT_PURGE_BATCH_SIZE=5000   # not read in v0.2.0
# HIVE_AUDIT_QUERY_MAX_PAGE_SIZE=500   # not read in v0.2.0
HIVE_AUDIT_DETAIL_MAX_BYTES=4096

# ─── Waggle Pipeline + Presence Registry (from [[Waggle Pipeline + Presence Registry]]) ─
HIVE_WAGGLE_QUIET_WINDOW_MS=500
HIVE_WAGGLE_REPLAY_DELAY_MS=0
# Wake-ups per fixed window for one sender on one mailbox. Provisional. A refused
# wake-up is still a stored message: only the wake is deferred to the end of the window.
HIVE_WAGGLE_SENDER_WAKEUPS_PER_WINDOW=5
HIVE_WAGGLE_SENDER_WINDOW_MS=60000
# Max simultaneous listen streams per participant (name kept for compatibility).
HIVE_PRESENCE_MAX_SESSIONS_PER_PARTICIPANT=16
# A presence entry lives exactly as long as its subscriptions/listen stream: no
# idle timeout, no sweep. At the cap above, the oldest stream is closed and the
# new one registers.
# Stream keep-alive and stalled-write detector. Provisional. The stall timeout must
# stay below 45000 (the silence after which `hivectl watch` reconnects).
HIVE_LISTEN_KEEPALIVE_INTERVAL_MS=15000
HIVE_LISTEN_STALL_TIMEOUT_MS=30000
# Lease granted to a listen that asks for one (hivectl watch v0.2.1+). A client that
# stops renewing it (silent network cut, sleeping laptop) goes offline within the
# lease. 0 disables leases; otherwise 400..86400000 and above
# HIVE_LISTEN_KEEPALIVE_INTERVAL_MS.
HIVE_LISTEN_LEASE_MS=60000

# ─── MCP Server + Tool Surface (from [[MCP Server + Tool Surface]]) ────────
# HIVE_MCP_HTTP_HOST/PORT/PATH are set by docker-compose.yml — overrides here
# only have effect if you bypass compose.
# HIVE_MCP_HTTP_HOST=0.0.0.0
# HIVE_MCP_HTTP_PORT=8443
# HIVE_MCP_HTTP_PATH=/mcp
HIVE_MCP_REVERIFY_INTERVAL_SECONDS=60           # re-check of open listen streams; 0 disables it, not for production
# Allow-lists for the Origin and Host headers (comma-separated). Empty origins: only
# clients that send no Origin pass. Empty hosts: Host is not validated. Set the hosts
# to your public name behind a reverse proxy.
# HIVE_MCP_ALLOWED_ORIGINS=
# HIVE_MCP_ALLOWED_HOSTS=hive.example.com
HIVE_MCP_LIST_AGENTS_MAX_PAGE_SIZE=100
HIVE_MCP_LOG_LEVEL=info                         # trace | debug | info | warn | error | fatal
HIVE_MCP_LOG_PRETTY=false                       # true only for local dev
HIVE_MCP_SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
HIVE_MCP_READYZ_DB_TIMEOUT_MS=500

# Note: HIVE_IMAGE_TAG is intentionally OMITTED — Hive v0.1 stays internal
# during Fase 1 per ADR-010 (no GHCR publication). The image is built locally
# from `deployment/Dockerfile` via `docker compose build`. When public
# distribution opens (PRY-009 follow-up) this var will be added.
