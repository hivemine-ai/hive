#!/usr/bin/env node

const { execFileSync } = require('node:child_process');
const os = require('node:os');
const path = require('node:path');

const PLATFORMS = {
  'darwin arm64': { pkg: '@hivemine/hivectl-darwin-arm64', bin: 'hivectl' },
  'darwin x64': { pkg: '@hivemine/hivectl-darwin-x64', bin: 'hivectl' },
  'linux arm64': { pkg: '@hivemine/hivectl-linux-arm64', bin: 'hivectl' },
  'linux x64': { pkg: '@hivemine/hivectl-linux-x64', bin: 'hivectl' },
};

const key = `${process.platform} ${os.arch()}`;
const target = PLATFORMS[key];

if (!target) {
  process.stderr.write(`hivectl: unsupported platform: ${key}\n`);
  process.stderr.write(
    `Supported platforms: ${Object.keys(PLATFORMS).join(', ')}\n`,
  );
  process.exit(1);
}

try {
  const binPath = path.join(
    path.dirname(require.resolve(`${target.pkg}/package.json`)),
    'bin',
    target.bin,
  );
  execFileSync(binPath, process.argv.slice(2), { stdio: 'inherit' });
} catch (e) {
  if (e && typeof e.status === 'number') {
    process.exit(e.status);
  }
  process.stderr.write(`hivectl: binary for ${key} not found.\n`);
  process.stderr.write(
    `Try reinstalling: npm install -g @hivemine/hivectl\n`,
  );
  process.exit(1);
}
