{
  "name": "@hive/cli",
  "version": "0.1.0-dev",
  "private": true,
  "description": "hivectl — admin CLI for Hive operators.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hivectl": "./dist/main.js"
  },
  "imports": {
    "#audit/*": "./dist/audit/*",
    "#commands/*": "./dist/commands/*",
    "#composition/*": "./dist/composition/*",
    "#error/*": "./dist/error/*",
    "#input/*": "./dist/input/*",
    "#output/*": "./dist/output/*",
    "#platform/*": "./dist/platform/*",
    "#runtime/*": "./dist/runtime/*",
    "#signals/*": "./dist/signals/*",
    "#types.js": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "sea:bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist-sea/bundle.cjs --external:better-sqlite3 --external:pg --external:pg-native --external:fsevents --banner:js=\"require=require('node:module').createRequire(__filename);\"",
    "sea:patch": "node scripts/patch-sea-bundle.mjs",
    "sea:blob": "node --experimental-sea-config sea-config.json",
    "sea:copy": "node -e \"require('node:fs').copyFileSync(process.execPath, 'dist-sea/hivectl')\"",
    "sea:unsign": "codesign --remove-signature dist-sea/hivectl",
    "sea:inject": "npx --yes postject@1.0.0-alpha.6 dist-sea/hivectl NODE_SEA_BLOB dist-sea/sea-prep.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2 --macho-segment-name NODE_SEA",
    "sea:resign": "codesign --sign - dist-sea/hivectl",
    "sea:build:linux": "pnpm run sea:bundle && pnpm run sea:patch && pnpm run sea:blob && pnpm run sea:copy && pnpm run sea:inject",
    "sea:build:darwin": "pnpm run sea:bundle && pnpm run sea:patch && pnpm run sea:blob && pnpm run sea:copy && pnpm run sea:unsign && pnpm run sea:inject && pnpm run sea:resign"
  },
  "dependencies": {
    "@hive/server": "workspace:*",
    "@hive/shared": "workspace:*",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "vitest": "^2.1.8"
  }
}
