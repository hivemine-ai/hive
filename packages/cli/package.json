{
  "name": "@hive/cli",
  "version": "0.1.0-dev",
  "private": true,
  "description": "hivectl — admin CLI for Hive operators.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hivectl": "./dist/main.js"
  },
  "imports": {
    "#audit/*": "./dist/audit/*",
    "#commands/*": "./dist/commands/*",
    "#error/*": "./dist/error/*",
    "#input/*": "./dist/input/*",
    "#output/*": "./dist/output/*",
    "#runtime/*": "./dist/runtime/*",
    "#signals/*": "./dist/signals/*",
    "#types.js": "./dist/types.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hive/server": "workspace:*",
    "@hive/shared": "workspace:*",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
