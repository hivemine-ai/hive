    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
