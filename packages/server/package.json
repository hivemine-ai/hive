{
  "name": "@hive/server",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Hive MCP server, domain logic, and persistence layer.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#persistence/*": "./dist/persistence/*",
